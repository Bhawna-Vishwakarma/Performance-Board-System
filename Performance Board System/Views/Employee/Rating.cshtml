@{  
    ViewData["Title"] = "My Rating";  
}  

<div class="dashboardLayout" id="dashboardLayout">  
    <!-- Main Content -->  
    <div class="mainContent p-3" id="mainContent">  
        <div class="rating-card">  
            <div class="d-flex justify-content-between align-items-center mb-4">   
                <h3 class="mb-0">My Ratings</h3>  
                <span class="badge bg-info text-dark">Last updated: @((DateTime)ViewBag.LastUpdated)</span>  
            </div>  

            <div class="mb-4">  
                <h5>Average Score</h5>  
                <div class="average-score">  
                    @ViewBag.AverageScore.ToString("0.0") / 25 <i class="bi bi-star-fill me-1"></i>  
                </div>  
                <p class="text-muted">Based on performance reviews from managers and peers.</p>  
            </div>  

            <hr />  

            @foreach (var categoryScore in ViewBag.Categories)  
            {
                string category = categoryScore.Item1;
                decimal score = categoryScore.Item2;
                @* string category = categoryScore.Key;  
                decimal score = categoryScore.Value;   *@

                var color = category switch  
                {  
                    "Communication" => "bg-success",  
                    "Teamwork" => "bg-info",  
                    "Punctuality" => "bg-warning",  
                    "Task Completion" => "bg-secondary",  
                    "Attendance" => "bg-primary",  
                    _ => "bg-dark"  
                };  

                var percent = (score / 5.0m) * 100;  

                <div class="mb-2">  
                    <div class="d-flex justify-content-between">  
                        <strong>@category</strong>  
                        <span>@score.ToString("0.0")</span>  
                    </div>  
                    <div class="progress">  
                        <div class="progress-bar @color" role="progressbar" style="width: @percent%;" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>  
                    </div>  
                </div>  
            }  
        </div>  
    </div>  
</div>