                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    } *@
    <div class="">
        @if (!isAuthPage)
        {
            <!-- Sidebar -->
            @if (userRole == 1)
            {
                <div class="text-white p-3" id="sidebar">
                    <h5 class="mb-4">Performance Board System</h5>

                    <ul class="nav flex-column">

                        <li class="nav-item mb-2">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="AdminDashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="DepartmentList">
                                <i class="bi bi-diagram-3"></i> Departments
                            </a>
                        </li>
                        <li class="nav-item mb-2">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="DesignationList">
                                <i class="bi bi-person-badge"></i> Designations
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="RoleList">
                                <i class="bi bi-person-check"></i> Roles
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="RatingList">
                                <i class="bi bi-star-half"></i> Rating Master
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="AttendanceStatusList">
                                <i class="bi bi-calendar-check"></i> Attendance Status
                            </a>
                        </li>

                        <li class="nav-item mb-2">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="UserList">
                                <i class="bi bi-person-circle"></i> User Management
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </li>

                    </ul>
                </div>

            }
            @if (userRole == 2)
            {
                <div class="text-white p-3" id="sidebar">
                    <h4 class="mb-4">Performance Board System</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Manager" asp-action="ManagerDashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Manager" asp-action="UserList">
                                <i class="bi bi-person-circle"></i> User Managment
                            </a>
                        </li>
                        @* <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Feedback">
                                <i class="bi bi-chat-left-text"></i> Feedback
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Employee" asp-action="Attendance">
                                <i class="bi bi-calendar-check"></i> Attendance
                            </a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock"></i> Privacy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </li>
                    </ul>
                </div>
            }
            @if (userRole == 3)
            {
                <div class="text-white p-3" id="sidebar">
                    <h4 class="mb-4">Performance Board System</h4>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Employee" asp-action="EmployeeDashboard">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Employee" asp-action="Rating">
                                <i class="bi bi-star-half"></i> My Ratings
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Feedback">
                                <i class="bi bi-chat-left-text"></i> Feedback
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Employee" asp-action="Attendance">
                                <i class="bi bi-calendar-check"></i> Attendance
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-lock"></i> Privacy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </li>
                    </ul>
                </div>
            }
        }
        <main role="main">
            @RenderBody()
            @if(!isAuthPage){
                <footer class="mainContent border-top mt-5 mb-3 footer text-muted">
                    <div class="container text-center">
                        &copy; 2025 - Performance_Board_System - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </div>
                </footer>
            }
        </main>
    </div>

    @* @if(!isAuthPage)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2025 - Performance_Board_System - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    } *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Toaster.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
