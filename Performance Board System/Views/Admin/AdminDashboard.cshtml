@model IEnumerable<Department>
@{
    ViewData["Title"] = "Admin Dashboard ";
    var userName = Context.Session.GetString("UserFullName");
    var userEmail = Context.Session.GetString("UserEmail");
    var userRole = Context.Session.GetString("UserRole");
    // int count = 1;
}


<div class="dashboardLayout" id="dashboardLayout">
    <!-- Main Content -->
    <div class="mainContent p-3 px-4" id="mainContent">
        <h3 id="welcomeText" class="mb-3 animated-heading"></h3>
        <h4 class="section-heading mt-4 mb-2">📊 Master Records</h4>
        <div class="row text-center">
            <div class="col-md-3 mb-4" style="cursor: pointer;" onclick="window.location.href='@Url.Action("DepartmentList", "Admin")'">
                <div class="card dashboard-card shadow-sm border-start border-5 border-success">
                    <div class="card-body">
                        <i class="bi bi-building text-success fs-3"></i>
                        <h5 class="mt-2">Departments</h5>
                        <h2 class="fw-bold counter" data-target="@ViewBag.TotalDepartments">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4" style="cursor: pointer;" onclick="window.location.href='@Url.Action("DesignationList", "Admin")'">
                <div class="card dashboard-card shadow-sm border-start border-5 border-warning">
                    <div class="card-body">
                        <i class="bi bi-person-badge text-warning fs-3"></i>
                        <h5 class="mt-2">Designations</h5>
                        <h2 class="fw-bold counter" data-target="@ViewBag.TotalDesignations">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4" style="cursor: pointer;" onclick="window.location.href='@Url.Action("RoleList", "Admin")'">
                <div class="card dashboard-card shadow-sm border-start border-5 border-danger">
                    <div class="card-body">
                        <i class="bi bi-person-gear text-danger fs-3"></i>
                        <h5 class="mt-2">Roles</h5>
                        <h2 class="fw-bold counter" data-target="@ViewBag.TotalRoles">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4" style="cursor: pointer;" onclick="window.location.href='@Url.Action("RatingList", "Admin")'">
                <div class="card dashboard-card shadow-sm border-start border-5 border-info">
                    <div class="card-body">
                        <i class="bi bi-stars text-info fs-3"></i>
                        <h5 class="mt-2">Ratings</h5>
                        <h2 class="fw-bold counter" data-target="@ViewBag.TotalRatings">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4" style="cursor: pointer;" onclick="window.location.href='@Url.Action("AttendanceStatusList", "Admin")'">
                <div class="card dashboard-card shadow-sm border-start border-5 border-warning">
                    <div class="card-body">
                        <i class="bi bi-calendar-check text-warning fs-3"></i>
                        <h5 class="mt-2">Attendance Status</h5>
                        <h2 class="fw-bold counter" data-target="@ViewBag.TotalAttendanceStatus">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-4" style="cursor: pointer;" onclick="window.location.href='@Url.Action("UserList", "Admin")'">
                <div class="card dashboard-card shadow-sm border-start border-5 border-info">
                    <div class="card-body">
                        <i class="bi bi-people-fill text-info fs-3"></i>
                        <h5 class="mt-2">Active Employees</h5>
                        <h2 class="fw-bold counter" data-target="@ViewBag.TotalUsers">0</h2>
                    </div>
                </div>
            </div>
        </div>
        <h4 class="section-heading mt-4"><i class="bi bi-calendar-range"></i> Latest Feedbacks</h4>
        <div class="table-responsive">
            <table class="table table-hover table-bordered border-warning align-middle text-center">
                <thead class="bg-primary text-white">
                    <tr>
                        <th><i class="bi bi-calendar-range"></i> Start</th>
                        <th><i class="bi bi-calendar-range"></i> End</th>
                        <th><i class="bi bi-person-circle"></i> Given By</th>
                        <th><i class="bi bi-person-bounding-box"></i> Given To</th>
                        <th><i class="bi bi-chat-left-text"></i> Comment</th>
                        <th><i class="bi bi-clock-history"></i> Evaluation Date</th>
                        <th><i class="bi bi-star-half"></i> Avg. Score</th>
                    </tr>
                </thead>
                <tbody class="bg-white">
                    @foreach (var eval in ViewBag.LatestFeedbacks)
                    {
                        <tr style ="cursor: pointer;" onclick="window.location.href='@Url.Action("FeedbackList", "Admin", new { userId = eval.EvaluatedUserId })'">
                            <td>@eval.EvaluationPeriodStart.ToShortDateString()</td>
                            <td>@eval.EvaluationPeriodEnd.ToShortDateString()</td>
                            <td>@eval.EvaluatorName</td>
                            <td>@eval.EvaluatedName</td>
                            <td>
                                <span title="@eval.Comment">
                                    @((eval.Comment?.Length ?? 0) > 30 ? eval.Comment.Substring(0, 30) + "..." : eval.Comment)
                                </span>
                            </td>
                            <td>@eval.EvaluationDate.ToShortDateString()</td>
                            <td>
                                <span class="badge bg-@GetScoreColor((decimal)eval.AverageScore)">
                                    @eval.AverageScore
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@await Html.PartialAsync("_ToasterNotification")
@functions {
    public string GetScoreColor(decimal score)
    {
        if (score >= 4.5m) return "success";
        else if (score >= 3.5m) return "warning";
        else return "danger";
    }
}
@section Scripts {
    <script>
        const text = "Welcome @userName 👋";
        let index = 0;
        const speed = 75;

        function typeEffect() {
            if (index < text.length) {
                document.getElementById("welcomeText").innerHTML += text.charAt(index);
                index++;
                setTimeout(typeEffect, speed);
            }
        }
        window.onload = typeEffect;
    </script>
}


