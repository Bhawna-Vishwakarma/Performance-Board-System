@model UserRolesAssignViewModel
@{
    ViewData["Title"] = "Assign Role/Department/Designation";
    // var userName = Context.Session.GetString("UserFullName");
    // var userEmail = Context.Session.GetString("UserEmail");
    // var userRole = Context.Session.GetString("UserRole");
}

<div class="dashboardLayout" id="dashboardLayout">
    <!-- Main Content -->
    <div class="mainContent p-3" id="mainContent">
        <h4>Assign Role/Department/Designation to @Model.FullName</h4>

        <form asp-action="AssignRole" method="post">
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="FullName" />

            <div class="mb-3">
                <label asp-for="DepartmentID" class="form-label">Department</label>
                <select asp-for="DepartmentID" class="form-select">
                    <option value="">-- Select Department --</option>
                    @foreach (var dept in Model.Department)
                    {
                        <option value="@dept.DepartmentID">@dept.DepartmentName</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="DesignationId" class="form-label">Designation</label>
                <select asp-for="DesignationId" class="form-select">
                    <option value="">-- Select Designation --</option>
                    @foreach (var desig in Model.Designation)
                    {
                        <option value="@desig.DesignationId">@desig.Title</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="RoleId" class="form-label">Role</label>
                <select asp-for="RoleId" class="form-select">
                    <option value="">-- Select Role --</option>
                    @foreach (var role in Model.Role)
                    {
                        <option value="@role.RoleId">@role.RoleName</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>