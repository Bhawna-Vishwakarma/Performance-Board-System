@model IEnumerable<UsersViewModel>
@{
    ViewData["Title"] = "Admin Dashboard ";
    // var userName = Context.Session.GetString("UserFullName");
    // var userEmail = Context.Session.GetString("UserEmail");
    // var userRole = Context.Session.GetString("UserRole");
    int count = 1;

}

<div class="dashboardLayout" id="dashboardLayout">
    <!-- Main Content -->
    <div class="mainContent p-3" id="mainContent">
        <h4 class="mb-4"><i class="bi bi-person-circle"></i> User Records</h4>
        @* <a asp-action="CreateUser" class="btn add-new-btn text-white my-2">Add New</a> *@
        <table class="table table-bordered border-primary bg-light">
            <thead class="bg-primary text-white">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Designation</th>
                    <th>Department</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@count</td>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.RoleName</td>
                        <td>@user.Title</td>
                        <td>@user.DepartmentName</td>
                        <td>
                            @if(user.IsActive == true)
                            {
                                <a asp-action="AssignRole" asp-route-id="@user.UserId" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                <form asp-action="DeleteUser" asp-route-id="@user.UserId" method="post" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm(`Are you sure want to Delete @user.FullName?`)"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="AddUser" asp-route-id="@user.UserId" method="post" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i></button>
                                </form>
                            }

                        </td>
                        </tr>
                    count++;
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_ToasterNotification")
